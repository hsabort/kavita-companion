{
  "name": "kavita-companion",
  "version": "0.8.1",
  "private": true,
  "description": "Upload portal for the Kavita server: Kavita login, resumable uploads, admin review queue.",
  "license": "Apache-2.0",
  "author": "James VanTassel",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p . && node build-web.mjs",
    "start": "node dist/server.js",
    "licences": "node scripts/check-licences.mjs",
    "test": "npm run build && node --test ../tests/conformance/*.test.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@tus/file-store": "2.1.2",
    "@tus/server": "2.4.7",
    "fast-xml-parser": "5.12.0",
    "fastify": "5.12.8",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/yazl": "3.3.1",
    "@uppy/core": "6.3.1",
    "@uppy/dashboard": "6.0.3",
    "@uppy/tus": "6.0.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
