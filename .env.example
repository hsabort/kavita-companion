# Copy to .env (./setup.sh does this for you and fills in the values). Never commit .env.

# ---- Public address ----
# Hostname the HTTPS certificates are issued for. Must resolve to this server.
DOMAIN=kavita.example.com

# ---- Ports on the host ----
# Kavita over HTTPS (what users open).
KAVITA_HTTPS_PORT=20005
# kavita-companion (upload portal) over HTTPS.
COMPANION_HTTPS_PORT=20004
# Caddy's plain-HTTP listener for Let's Encrypt HTTP-01 checks. Let's Encrypt always connects to
# port 80 of DOMAIN: set 80 here if this host owns port 80, otherwise forward /.well-known/acme-challenge/
# from whatever owns port 80 to this port (docs/install.md, "HTTPS certificates").
ACME_HTTP_PORT=20003
# Kavita's plain HTTP for local admin tools; bound to DOCKER_GATEWAY only, never public.
KAVITA_LOCAL_PORT=20001
# Address the HTTPS/ACME ports are published on. 0.0.0.0 = all interfaces.
PUBLISH_ADDRESS=0.0.0.0

# ---- Docker network ----
# Private network for the three containers. Change if it clashes with another network on the host.
DOCKER_SUBNET=172.30.0.0/24
DOCKER_GATEWAY=172.30.0.1
COMPOSE_PROJECT_NAME=kavita

# ---- Storage ----
# Media library: manga/, comics/, books/ and .incoming/ (upload staging) are created inside it.
MEDIA_ROOT=/srv/media
# Runtime data (Kavita's database, the portal's database and backups, Caddy's certificates).
DATA_ROOT=./data

# ---- Users and time ----
# Containers run as this user/group; it must own MEDIA_ROOT and DATA_ROOT.
PUID=1000
PGID=1000
TZ=America/New_York

# ---- Versions (pinned; upgrades are deliberate, see docs/operations.md) ----
KAVITA_IMAGE_TAG=v0.9.1.4-ls128
CADDY_IMAGE_TAG=2.11.7-alpine

# ---- kavita-companion ----
# Run a prebuilt image instead of building from ./kavita-companion. Leave empty to build locally (the
# default). Set it to a published tag to deploy a released build, e.g.
#   COMPANION_IMAGE=ghcr.io/hsabort/kavita-companion:0.2.1
# Pulling the private package needs a one-off `docker login ghcr.io` on the host (docs/operations.md).
COMPANION_IMAGE=
# Auth key of a Kavita admin account, used by the portal for library lookups and scans.
# ./setup.sh creates it.
COMPANION_KAVITA_AUTH_KEY=
# Random secret that encrypts the Kavita sessions the portal keeps to follow each user's theme.
# ./setup.sh generates it. Changing it only means users' themes update at their next sign-in.
COMPANION_SECRET=
# Upload limits.
MAX_FILE_GB=8
MAX_PENDING_GB_PER_USER=50
MAX_CONCURRENT_UPLOADS_PER_USER=3
MIN_FREE_DISK_GB=25

# ---- Test accounts (only for tests/; see tests/README.md). Leave empty in production. ----
TEST_UPLOADER_USERNAME=
TEST_UPLOADER_PASSWORD=
TEST_READONLY_USERNAME=
TEST_READONLY_PASSWORD=
TEST_ADMIN_USERNAME=
TEST_ADMIN_PASSWORD=
