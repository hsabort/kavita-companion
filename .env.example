# Copy to .env (./setup.sh does this for you and fills in the values). Never commit .env.

# ---- Public address ----
# Hostname the HTTPS certificates are issued for. Must resolve to this server.
DOMAIN=kavita.example.com

# ---- Ports on the host ----
# Kavita over HTTPS (what users open).
KAVITA_HTTPS_PORT=20005
# kavita-companion (upload portal) over HTTPS.
COMPANION_HTTPS_PORT=20004
# Caddy's plain-HTTP listener for Let's Encrypt HTTP-01 checks. Let's Encrypt always connects to
# port 80 of DOMAIN: set 80 here if this host owns port 80, otherwise forward /.well-known/acme-challenge/
# from whatever owns port 80 to this port (docs/install.md, "HTTPS certificates").
ACME_HTTP_PORT=20003
# Kavita's plain HTTP for local admin tools; bound to DOCKER_GATEWAY only, never public.
KAVITA_LOCAL_PORT=20001
# Address the HTTPS/ACME ports are published on. 0.0.0.0 = all interfaces.
PUBLISH_ADDRESS=0.0.0.0

# ---- Docker network ----
# Private network for the three containers. Change if it clashes with another network on the host.
DOCKER_SUBNET=172.30.0.0/24
DOCKER_GATEWAY=172.30.0.1
COMPOSE_PROJECT_NAME=kavita

# ---- Storage ----
# Media library: manga/, comics/, books/ and .incoming/ (upload staging) are created inside it.
MEDIA_ROOT=/srv/media
# Runtime data (Kavita's database, the portal's database and backups, Caddy's certificates).
DATA_ROOT=./data

# ---- Users and time ----
# Containers run as this user/group; it must own MEDIA_ROOT and DATA_ROOT.
PUID=1000
PGID=1000
TZ=America/New_York

# ---- Versions (pinned; upgrades are deliberate, see docs/operations.md) ----
KAVITA_IMAGE_TAG=v0.9.1.4-ls128
CADDY_IMAGE_TAG=2.11.7-alpine

# ---- kavita-companion ----
# Run a prebuilt image instead of building from ./kavita-companion. Leave empty to build locally (the
# default). Set it to a published tag to deploy a released build, e.g.
#   COMPANION_IMAGE=ghcr.io/hsabort/kavita-companion:0.2.1
# The image is public, so no login is needed (docs/operations.md).
COMPANION_IMAGE=
# Auth key of a Kavita admin account, used by the portal for library lookups and scans.
# ./setup.sh creates it.
COMPANION_KAVITA_AUTH_KEY=
# Random secret that encrypts the Kavita sessions the portal keeps to follow each user's theme.
# ./setup.sh generates it. Changing it only means users' themes update at their next sign-in.
COMPANION_SECRET=
# Upload limits.
MAX_FILE_GB=8
MAX_PENDING_GB_PER_USER=50
MAX_CONCURRENT_UPLOADS_PER_USER=3
MIN_FREE_DISK_GB=25

# Allow notification targets on private/LAN addresses (e.g. a self-hosted ntfy over http) and over
# http. Off by default: the target is user-supplied and the portal calls it server-side (docs/security.md).
NOTIFY_ALLOW_PRIVATE=false

# How often (ms) an open session re-reads the user's Kavita roles. Lowered in the test environment so
# tests/test_roles_and_limits.py doesn't wait two minutes twice. Leave at the default in production.
ROLE_RECHECK_MS=120000

# ---- External metadata providers (phase 2) ----
# Off by default: the portal makes no outbound metadata calls until an admin turns a provider on in
# the portal (About -> Metadata sources); every provider is off until then. See docs/compliance.md and
# docs/architecture.md.
# These are the framework-wide settings; per-provider settings are PROVIDER_<ID>_* (e.g.
# PROVIDER_METRON_KEY, PROVIDER_METRON_ENABLED, PROVIDER_METRON_BASE, PROVIDER_METRON_CACHE_TTL_DAYS).
METADATA_EXTERNAL_ENABLED=false
# Refuse private/LAN provider base URLs unless explicitly allowed (the test stack sets this true).
PROVIDERS_ALLOW_PRIVATE=false
# Shared outbound HTTP client: timeout, retries, backoff, and response size cap.
PROVIDER_HTTP_TIMEOUT_MS=8000
PROVIDER_HTTP_RETRIES=2
PROVIDER_HTTP_BACKOFF_MS=500
PROVIDER_HTTP_MAX_BYTES=2097152
# Provider record cache TTL in days (per-provider override: PROVIDER_<ID>_CACHE_TTL_DAYS).
PROVIDER_CACHE_TTL_DAYS=30
# Test only: register the built-in stub provider and point it at a fake. Leave off in production.
PROVIDERS_STUB=false
PROVIDER_STUB_BASE=
# Metron (comics; the primary comics provider). Off until enabled; each install needs its own free
# Metron account and bearer token (never shipped — set it in the portal, or here as a seed). Cover
# images are never fetched (fair use). Base is normally https://metron.cloud.
PROVIDER_METRON_BASE=https://metron.cloud
PROVIDER_METRON_KEY=
PROVIDER_METRON_ENABLED=false
PROVIDER_METRON_CACHE_TTL_DAYS=30
# Grand Comics Database (comics; the fallback provider). Keyless; off until enabled. An optional
# `user:pass` free-account key raises the anonymous 30/hour limit to 2,000/day (HTTP Basic). Cover
# art is never fetched. Base is normally https://www.comics.org. The min-interval defaults pace the
# anonymous limit (30/hour = 120 s) and the authenticated one; lower them only if you know why.
PROVIDER_GCD_BASE=https://www.comics.org
PROVIDER_GCD_KEY=
PROVIDER_GCD_ENABLED=false
PROVIDER_GCD_MIN_INTERVAL_MS=120000
PROVIDER_GCD_MIN_INTERVAL_MS_AUTHED=5000
PROVIDER_GCD_CACHE_TTL_DAYS=30
# MangaDex (manga; the primary manga provider). Keyless and server-side only (its API has no
# third-party CORS, so the browser never calls it); credit "MangaDex" is required, the data must not
# power ads/paid services, and covers are never fetched (MangaDex forbids hotlinking). Base is normally
# https://api.mangadex.org; ~5 requests/s per IP -> a 250 ms spacing. Caches for 7 days.
PROVIDER_MANGADEX_BASE=https://api.mangadex.org
PROVIDER_MANGADEX_ENABLED=false
PROVIDER_MANGADEX_MIN_INTERVAL_MS=250
PROVIDER_MANGADEX_CACHE_TTL_DAYS=7
# AniList (manga + light novels; the manga fallback). Keyless GraphQL. Its terms forbid using the API
# as a data-storage/backup service, so the cache is deliberately short (3 days) and lookups stay
# per-review. Base is normally https://graphql.anilist.co; 90/min documented but degraded to 30/min
# -> a 2000 ms spacing. Covers are never fetched.
PROVIDER_ANILIST_BASE=https://graphql.anilist.co
PROVIDER_ANILIST_ENABLED=false
PROVIDER_ANILIST_MIN_INTERVAL_MS=2000
PROVIDER_ANILIST_CACHE_TTL_DAYS=3
# Hardcover (books; the primary books provider). Keyed: each install needs its own free personal access
# token (never shipped — set it in the portal, or here as a seed). Hardcover forbids LLM-training use and
# resale of user-owned data, and image use needs a DMCA policy, so covers are never fetched. The base
# includes the endpoint path (Hardcover's GraphQL lives at /v1/graphql); free tier 60/min -> a 1 s spacing.
PROVIDER_HARDCOVER_BASE=https://api.hardcover.app/v1/graphql
PROVIDER_HARDCOVER_KEY=
PROVIDER_HARDCOVER_ENABLED=false
PROVIDER_HARDCOVER_MIN_INTERVAL_MS=1000
PROVIDER_HARDCOVER_CACHE_TTL_DAYS=30
# Open Library (books; the fallback provider). Keyless, but a truthful User-Agent is required (the shared
# client sends one; set COMPANION_CONTACT_EMAIL for the identified 3/s tier). IA asserts no new rights and
# warns existing rights may apply; covers are never fetched. 1 request/s anonymous -> a 1 s spacing.
PROVIDER_OPENLIBRARY_BASE=https://openlibrary.org
PROVIDER_OPENLIBRARY_ENABLED=false
PROVIDER_OPENLIBRARY_MIN_INTERVAL_MS=1000
PROVIDER_OPENLIBRARY_CACHE_TTL_DAYS=30

# ---- Test accounts (only for tests/; see tests/README.md). Leave empty in production. ----
TEST_UPLOADER_USERNAME=
TEST_UPLOADER_PASSWORD=
TEST_READONLY_USERNAME=
TEST_READONLY_PASSWORD=
TEST_ADMIN_USERNAME=
TEST_ADMIN_PASSWORD=
