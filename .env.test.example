# Test-environment settings. Copy to .env in the test checkout (git worktree, docs/development.md):
#
#   git worktree add -b develop ../kavita-test main
#   cd ../kavita-test && cp .env.test.example .env && chmod 600 .env
#   KAVITA_ADMIN_USERNAME=admin KAVITA_ADMIN_PASSWORD='...' \
#     COMPOSE_ENV_FILES=.env ./setup.sh --non-interactive
#
# Every value that would clash with the live stack is different: project name, ports, Docker subnet,
# data and media folders, and the portal image tag. Run ./setup.sh once; it fills in
# COMPANION_KAVITA_AUTH_KEY and COMPANION_SECRET. Never commit .env.

# ---- Public address ----
# Same domain as live: this stack reuses live's Let's Encrypt certificate (compose.test.yaml), so
# there is no ACME here and DNS/port 80 are unchanged.
DOMAIN=kavita.example.com

# ---- Ports on the host (all inside the host's forwarded range, distinct from live) ----
KAVITA_HTTPS_PORT=20007
COMPANION_HTTPS_PORT=20006
# Published but unused (this stack runs no ACME); kept so the compose file is identical to live.
ACME_HTTP_PORT=20008
KAVITA_LOCAL_PORT=20002
PUBLISH_ADDRESS=0.0.0.0

# ---- Docker network (must differ from the live stack's DOCKER_SUBNET) ----
DOCKER_SUBNET=172.31.0.0/24
DOCKER_GATEWAY=172.31.0.1
COMPOSE_PROJECT_NAME=kavita-test

# ---- Test-stack wiring ----
# Marks this .env as a test stack. tests/settings.py refuses to run without it, so a stray run in a
# checkout that is not marked (e.g. live) can never resolve its media root to the live library.
TEST_STACK=1
# Load compose.test.yaml as an overlay, use the test Caddyfile, build/test a separate portal image.
COMPOSE_FILE=compose.yaml:compose.test.yaml
CADDYFILE=Caddyfile.test
COMPANION_IMAGE=kavita-companion:test
# Folder holding the live stack's certificate files (mounted read-only at /certs by compose.test.yaml).
# Caddy serves {$DOMAIN}.crt and {$DOMAIN}.key from here.
LIVE_CERT_DIR=/srv/kavita/data/caddy/data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/kavita.example.com

# ---- Storage (separate from live) ----
MEDIA_ROOT=/srv/media-test
DATA_ROOT=./data-test

# ---- Users and time ----
PUID=1001
PGID=1001
TZ=America/New_York

# ---- Versions (keep in step with .env.example) ----
KAVITA_IMAGE_TAG=v0.9.1.4-ls128
CADDY_IMAGE_TAG=2.11.7-alpine

# ---- kavita-companion ----
# ./setup.sh creates these.
COMPANION_KAVITA_AUTH_KEY=
COMPANION_SECRET=
MAX_FILE_GB=8
MAX_PENDING_GB_PER_USER=50
MAX_CONCURRENT_UPLOADS_PER_USER=3
MIN_FREE_DISK_GB=25
# The tests deliver to a receiver on the host (http://172.31.0.1:...), so private targets are allowed here.
NOTIFY_ALLOW_PRIVATE=true
# Re-read roles almost immediately so the roles test doesn't wait two minutes twice.
ROLE_RECHECK_MS=300

# ---- External metadata providers (test stack) ----
# Exercise the phase-2 provider framework and the real adapters with tests/provider_fake.py through
# the Docker gateway. No real provider is ever called.
METADATA_EXTERNAL_ENABLED=true
PROVIDERS_STUB=true
PROVIDERS_ALLOW_PRIVATE=true
PROVIDER_STUB_BASE=http://172.31.0.1:20900
# Metron adapter (W2) and GCD adapter (W3) against the in-process fake on their own ports.
PROVIDER_METRON_BASE=http://172.31.0.1:20901
PROVIDER_GCD_BASE=http://172.31.0.1:20902
PROVIDER_GCD_MIN_INTERVAL_MS=0
PROVIDER_GCD_MIN_INTERVAL_MS_AUTHED=0
# MangaDex adapter (W4) and AniList adapter (W5) against the in-process fake; both keyless.
PROVIDER_MANGADEX_BASE=http://172.31.0.1:20903
PROVIDER_MANGADEX_MIN_INTERVAL_MS=0
PROVIDER_ANILIST_BASE=http://172.31.0.1:20904
PROVIDER_ANILIST_MIN_INTERVAL_MS=0
# Hardcover adapter (W6) and Open Library adapter (W7) against the in-process fake; Hardcover is keyed
# (the test sets a dummy token), Open Library is keyless.
PROVIDER_HARDCOVER_BASE=http://172.31.0.1:20905/v1/graphql
PROVIDER_HARDCOVER_MIN_INTERVAL_MS=0
PROVIDER_OPENLIBRARY_BASE=http://172.31.0.1:20906
PROVIDER_OPENLIBRARY_MIN_INTERVAL_MS=0
# Short cache TTL so the TTL test needs no long sleep.
PROVIDER_CACHE_TTL_MS=1500
PROVIDER_HTTP_TIMEOUT_MS=5000
PROVIDER_HTTP_BACKOFF_MS=200

# ---- Test accounts (this is the test environment: these are expected to be set) ----
TEST_UPLOADER_USERNAME=
TEST_UPLOADER_PASSWORD=
TEST_READONLY_USERNAME=
TEST_READONLY_PASSWORD=
TEST_ADMIN_USERNAME=
TEST_ADMIN_PASSWORD=
